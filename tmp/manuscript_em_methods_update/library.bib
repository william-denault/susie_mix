	doi = {10.1056/NEJMoa010806},
	abstract = {The increased risk of low birth weight among infants conceived with assisted reproductive technology has been attributed in large part to the higher rate of multiple gestations associated with this technology. This study used population-based data to compare the rates of low birth weight in infants from singleton and multiple gestations conceived with this technology with the rates in the general population. Infants conceived with assisted reproductive technology accounted for 0.6 percent of all infants born in the United States to mothers 20 years of age or older in 1997, but they accounted for 3.5 percent of low-birth-weight and 4.3 percent of very-low-birth-weight infants.},
