	month = jun,
	year = {2020},
	keywords = {Transcriptomics, Gene expression profiling, Depression, Oligodendrocyte},
	pages = {771--781},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\TBGUFSD4\\Nagy et al. - 2020 - Single-nucleus transcriptomics of the prefrontal cortex in major depressive disorder implicates olig.pdf:application/pdf},
