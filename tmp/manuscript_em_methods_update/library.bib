@article{satokata_msx1_1994,
	title = {Msx1 deficient mice exhibit cleft palate and abnormalities of craniofacial and tooth development},
	volume = {6},
	issn = {1061-4036},
	doi = {10.1038/ng0494-348},
	abstract = {The Msx1 homeobox gene is expressed at diverse sites of epithelial-mesenchymal interaction during vertebrate embryogenesis, and has been implicated in signalling processes between tissue layers. To determine the phenotypic consequences of its deficiency, we prepared mice lacking Msx1 function. All Msx1- homozygotes manifest a cleft secondary palate, a deficiency of alveolar mandible and maxilla and a failure of tooth development. These mice also exhibit abnormalities of the nasal, frontal and parietal bones, and of the malleus in the middle ear. Msx1 thus has a critical role in mediating epithelial-mesenchymal interactions during craniofacial bone and tooth development. The Msx1-/Msx1- phenotype is similar to human cleft palate, and provides a genetic model for cleft palate and oligodontia in which the defective gene is known.},
	language = {eng},
	number = {4},
	journal = {Nat. Genet.},
	author = {Satokata, I. and Maas, R.},
	month = apr,
	year = {1994},
	keywords = {Female, Humans, Male, Animals, Mice, Cell Line, Cleft Palate, MSX1 Transcription Factor, Phenotype, Transcription Factors, Molecular Sequence Data, Abnormalities, Multiple, Genes, Recessive, Facial Bones, Homeodomain Proteins, Morphogenesis, Skull, Base Sequence, Chimera, Dental Papilla, Disease Models, Animal, DNA-Binding Proteins, Embryo Transfer, Embryonic Induction, Genes, Homeobox, Genes, Lethal, Head, Jaw Abnormalities, Malleus, Mesoderm, Mice, Mutant Strains, Tooth Abnormalities},
