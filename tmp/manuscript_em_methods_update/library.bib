	keywords = {data integration, DNA Methylation, CENH3, Co-Evolution, Populus trichocarpa centromeres, SNP density, Wavelet Transform},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\2MUPMIHF\\Weighill et al. - 2019 - Wavelet-Based Genomic Signal Processing for Centro.pdf:application/pdf},
