	keywords = {Wavelet transforms, Convolution, Noise reduction, Constrained Optimization, Framelet Transforms, Graph Neural Networks, Noise, Smoothing methods, Spectral Methods, Transforms, US Department of Transportation},
	pages = {1--11},
	file = {IEEE Xplore Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\ABT2NWAX\\Zhou et al. - 2024 - Graph Denoising with Framelet Regularizers.pdf:application/pdf},
}

@article{li_permutation_2024,
