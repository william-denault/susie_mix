## Main function
 This is a light weight version David Gerard binomial thinning method

```{r function}
# ----------------- binomial thinning (seqgendiff) -------------------- #
# Faithful port of seqgendiff:::thin_base, with the dimension checks made
# active (the original used bare assertthat::are_equal(), which never
# throws -- so mismatched dimensions slipped through and rbinom() then
# silently recycled size/prob into garbage).
thin_base <- function(mat, designmat, coefmat,
                      relative = TRUE, type = c("thin", "mult")) {
  assert_that(is.matrix(mat), is.matrix(designmat), is.matrix(coefmat))
  assert_that(is.numeric(mat), is.numeric(designmat), is.numeric(coefmat))
  assert_that(nrow(mat)       == nrow(coefmat))    # features  (positions)
  assert_that(ncol(mat)       == nrow(designmat))  # samples   (individuals)
  assert_that(ncol(designmat) == ncol(coefmat))    # covariates (effects)
  assert_that(is.logical(relative), length(relative) == 1L)
  stopifnot(mat >= 0)
  type    <- match.arg(type)
  meanmat <- tcrossprod(coefmat, designmat)        # positions x individuals
  maxvec  <- apply(meanmat, 1, max)
  if (!relative) {
    if (any(maxvec > 0))
      stop("thin_base: positive log2-means with relative = FALSE.")
    qmat <- 2^meanmat
  } else {
    qmat <- 2^(meanmat - maxvec)
  }
  newmat <- if (type == "thin")
    stats::rbinom(prod(dim(mat)), size = mat, prob = qmat)
  else
    round(qmat * mat)
  dim(newmat) <- dim(mat)
  newmat
}
```

