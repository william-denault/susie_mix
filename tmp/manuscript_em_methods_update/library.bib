	author = {Novakovic, Boris and Lewis, Sharon and Halliday, Jane and Kennedy, Joanne and Burgner, David P. and Czajko, Anna and Kim, Bowon and Sexton-Oates, Alexandra and Juonala, Markus and Hammarberg, Karin and Amor, David J. and Doyle, Lex W. and Ranganathan, Sarath and Welsh, Liam and Cheung, Michael and McBain, John and McLachlan, Robert and Saffery, Richard},
