	file = {PubMed Central Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\PC98MAHF\\Bulik-Sullivan et al. - 2015 - An Atlas of Genetic Correlations across Human Dise.pdf:application/pdf},
}

