	keywords = {Humans, Animals, Models, Biological, Signal Transduction, Nuclear Proteins, Cell Nucleus, actin, Actins, cytoskeleton, Cytoskeleton, Fetal Proteins, formins, Formins, Microfilament Proteins, microtubules, Microtubules, nucleus},
	pages = {1701--1708},
}

@article{kawabata_galbraith_multiple_2019,
	series = {Timing and shaping mechanisms of neural development},
	title = {Multiple roles of the actin and microtubule-regulating formins in the developing brain},
