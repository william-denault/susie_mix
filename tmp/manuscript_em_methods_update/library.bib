@article{davies_maternal_2017,
	title = {Maternal factors and the risk of birth defects after {IVF} and {ICSI}: a whole of population cohort study},
	volume = {124},
	issn = {1471-0528},
	shorttitle = {Maternal factors and the risk of birth defects after {IVF} and {ICSI}},
	doi = {10.1111/1471-0528.14365},
	abstract = {OBJECTIVE: To assess the contribution of maternal factors to major birth defects after in vitro fertilisation (IVF), intracytoplasmic sperm injection (ICSI), and natural conception.
DESIGN: Retrospective cohort study in South Australia for the period January 1986 to December 2002.
SETTING: A whole of population study.
POPULATION: A census of all IVF and ICSI linked to registries for births, pregnancy terminations, and birth defects (diagnosed before a child's fifth birthday).
METHODS: Odds ratios (ORs) for birth defects were calculated among IVF, ICSI, and natural conceptions for maternal age, parity, pre-pregnancy BMI, smoking, pre-existing diseases, and conditions in pregnancy, with adjustment for confounding factors.
MAIN OUTCOME MEASURES: Birth defects classified by International Classification of Diseases (ninth revision) and British Paediatric Association (ICD9-BPA) codes.
RESULTS: There were 2211 IVF, 1399 ICSI, and 301 060 naturally conceived births. The unadjusted prevalence of any birth defect was 7.1, 9.9, and 5.7\% in the IVF, ICSI, and natural conception groups, respectively. As expected, the risk of birth defects increased with maternal age among the natural conceptions. In contrast, for IVF and ICSI combined, relative to natural conceptions, births to women aged ≤29 years had a higher risk (adjusted odds ratio, aOR 1.42; 95\% confidence interval, 95\% CI 1.04-1.94), births to women aged 35-39 years had no difference in risk (aOR 1.01; 95\% CI 0.74-1.37), and births to women aged ≥40 years had a lower risk of defects (aOR 0.45; 95\% CI 0.22-0.92). Defects were also elevated for nulliparity, anaemia, and urinary tract infection in births after ICSI, but not after IVF.
CONCLUSIONS: The usual age-birth defect relationship is reversed in births after IVF and ICSI, and the associations for other maternal factors and defects vary between IVF and ICSI.
TWEETABLE ABSTRACT: Risk of birth defects in women over 40 years is lower after infertility treatment than for natural conceptions.},
	language = {eng},
	number = {10},
	journal = {BJOG},
	author = {Davies, M. J. and Rumbold, A. R. and Marino, J. L. and Willson, K. and Giles, L. C. and Whitrow, M. J. and Scheil, W. and Moran, L. J. and Thompson, J. G. and Lane, M. and Moore, V. M.},
	month = sep,
	year = {2017},
	keywords = {Female, Humans, Infant, Newborn, Pregnancy, Adult, Odds Ratio, Risk Factors, Congenital Abnormalities, Prevalence, Registries, Young Adult, Fertilization, Fertilization in Vitro, Infertility, Sperm Injections, Intracytoplasmic, ICSI, IVF, Birth defects, Maternal Age, maternal factors, Parity, Retrospective Studies, South Australia},
	pages = {1537--1544},
	file = {Version acceptée:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\J7E7YDWV\\Davies et al. - 2017 - Maternal factors and the risk of birth defects aft.pdf:application/pdf},
}

@article{bergh_long-term_nodate,
	title = {Long-term health of children conceived after assisted reproductive technology},
	volume = {125},
	issn = {0300-9734},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7721037/},
	doi = {10.1080/03009734.2020.1729904},
	abstract = {The aim of this narrative review is to summarize the present knowledge on long-term outcome of children born after assisted reproductive technologies (ART). The main outcomes covered are neurodevelopment including cerebral palsy, cognitive development, attention deficit hyperactivity disorder and autism spectrum disease, growth, cardiovascular function, diabetes type 1, asthma, malignancies, and reproductive health. Results have mainly been obtained from systematic reviews/meta-analyses and large registry studies. It has been shown that children born after ART, when restricted to singletons, have a similar outcome for many health conditions as their spontaneously conceived peers. For some outcomes, particularly cardiovascular function and diabetes, studies show some higher risk for ART singletons or subgroup of ART singletons. The fast introduction of new ART techniques emphasizes the importance of continuous surveillance of children born after ART.},
	number = {2},
	urldate = {2021-07-26},
	journal = {Ups J Med Sci},
	author = {Bergh, Christina and Wennerholm, Ulla-Britt},
	pages = {152--157},
