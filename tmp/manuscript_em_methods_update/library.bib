	author = {Yan, Jian and Qiu, Yunjiang and Ribeiro dos Santos, André M. and Yin, Yimeng and Li, Yang E. and Vinckier, Nick and Nariai, Naoki and Benaglio, Paola and Raman, Anugraha and Li, Xiaoyu and Fan, Shicai and Chiou, Joshua and Chen, Fulin and Frazer, Kelly A. and Gaulton, Kyle J. and Sander, Maike and Taipale, Jussi and Ren, Bing},
	month = mar,
	year = {2021},
	note = {Number: 7848},
	keywords = {Genome-wide association studies, Gene expression, Functional genomics, Transcriptional regulatory elements},
	pages = {147--151},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\FKUXF2Y2\\Yan et al. - 2021 - Systematic analysis of binding of transcription fa.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\T9UAGH2N\\s41586-021-03211-0.html:text/html},
