	month = feb,
	year = {2008},
	keywords = {Child, Child, Preschool, Female, Humans, Infant, Newborn, Male, Adolescent, Pedigree, Recurrence, Cleft Lip, Cleft Palate, Epidemiologic Methods, Infant},
	pages = {432--434},
	file = {Full Text:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\XADT8EFQ\\Sivertsen et al. - 2008 - Familial risk of oral clefts by morphological type.pdf:application/pdf},
