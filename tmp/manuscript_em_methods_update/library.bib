@inproceedings{kalra_why_2024,
	title = {Why {Warmup} the {Learning} {Rate}? {Underlying} {Mechanisms} and {Improvements}},
	shorttitle = {Why {Warmup} the {Learning} {Rate}?},
	url = {https://openreview.net/forum?id=NVl4SAmz5c&noteId=bavOSLCuxE},
	abstract = {In modern deep learning, it is common to warm up the learning rate \${\textbackslash}eta\$, often by a linear schedule between \${\textbackslash}eta\_\{{\textbackslash}text\{init\}\} = 0\$ and a predetermined target \${\textbackslash}eta\_\{{\textbackslash}text\{trgt\}\}\$. In this paper, we show through systematic experiments with SGD and Adam that the overwhelming benefit of warmup arises from allowing the network to tolerate larger \${\textbackslash}eta\_\{{\textbackslash}text\{trgt\}\}\$ by forcing the network to more well-conditioned areas of the loss landscape. The ability to handle larger target learning rates in turn makes hyperparameter tuning more robust while improving the final performance of the network. We uncover different regimes of operation during the warmup period, depending on whether the network training starts off in a progressive sharpening or sharpness reduction phase, which in turn depends on the initialization and parameterization. Using these insights, we show how \${\textbackslash}eta\_\{{\textbackslash}text\{init\}\}\$ can be properly chosen by utilizing the loss catapult mechanism, which saves on the number of warmup steps, in some cases completely eliminating the need for warmup. We also suggest an initialization for the variance in Adam, which provides benefits similar to warmup.},
	language = {en},
	urldate = {2025-04-04},
	author = {Kalra, Dayal Singh and Barkeshli, Maissam},
	month = nov,
	year = {2024},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\D6L8K77L\\Kalra and Barkeshli - 2024 - Why Warmup the Learning Rate Underlying Mechanisms and Improvements.pdf:application/pdf},
}

