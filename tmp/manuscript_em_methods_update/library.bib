	note = {Number: 1},
	pages = {17605},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\QD4FAYB4\\McRae et al. - 2018 - Identification of 55,000 Replicated DNA Methylatio.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\F3279FMB\\s41598-018-35871-w.html:text/html},
}

