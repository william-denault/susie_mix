#!/bin/bash
#SBATCH --job-name=rename_preflight
#SBATCH --output=rename_preflight_%j.out
#SBATCH --error=rename_preflight_%j.err
#SBATCH --partition=broadwl
#SBATCH --time=04:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G
set -euo pipefail
bundle=$1; project=$2
module load R/4.2.0
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript --vanilla "$bundle/preflight.R" "$bundle" "$project"
python3 "$bundle/check_bim.py" "$bundle" /project2/mstephens/gtex/GTEx_Analysis_2017-06-05_v8_WholeGenomeSeq_866Indiv.bim
