	pages = {1421--1427},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\8J94858W\\Gazal et al. - 2017 - Linkage disequilibrium–dependent architecture of h.pdf:application/pdf},
}

@article{plongthongkum_advances_2014,
	title = {Advances in the profiling of {DNA} modifications: cytosine methylation and beyond},
	volume = {15},
