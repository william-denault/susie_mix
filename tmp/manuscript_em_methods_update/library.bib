	keywords = {Software, Machine learning, Gene expression analysis, Statistical methods, Transcriptomics},
	pages = {229--238},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\74JWNVS2\\Townes et Engelhardt - 2023 - Nonnegative spatial factorization applied to spati.pdf:application/pdf},
}

