	keywords = {fine-mapping, human, chromatin, gwas, qtl, transcription},
	pages = {e39595},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\TAQT5NYQ\\Tehranchi et al. - 2019 - Fine-mapping cis-regulatory variants in diverse hu.pdf:application/pdf},
