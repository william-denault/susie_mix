	note = {\_eprint: https://doi.org/10.1080/01621459.2019.1679639},
	keywords = {Sparsity, Adaptive shrinkage estimation, Higher order minimax risk, Inference with side information, SURE shrinkage, Two-sample inference},
	pages = {2053--2067},
