	file = {Hammond et al. - 2011 - Wavelets on graphs via spectral graph theory.pdf:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\GGEPZTIA\\Hammond et al. - 2011 - Wavelets on graphs via spectral graph theory.pdf:application/pdf},
}

