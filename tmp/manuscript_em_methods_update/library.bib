	pages = {491--504},
	file = {Version acceptée:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\2RNN8YAV\\Schaid et al. - 2018 - From genome-wide associations to candidate causal .pdf:application/pdf},
}

