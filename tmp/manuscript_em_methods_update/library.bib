@article{cook_simulation-extrapolation_1994,
	title = {Simulation-{Extrapolation} {Estimation} in {Parametric} {Measurement} {Error} {Models}},
	volume = {89},
	issn = {0162-1459},
	url = {https://www.jstor.org/stable/2290994},
	doi = {10.2307/2290994},
	abstract = {We describe a simulation-based method of inference for parametric measurement error models in which the measurement error variance is known or at least well estimated. The method entails adding additional measurement error in known increments to the data, computing estimates from the contaminated data, establishing a trend between these estimates and the variance of the added errors, and extrapolating this trend back to the case of no measurement error. We show that the method is equivalent or asymptotically equivalent to method-of-moments estimation in linear measurement error modeling. Simulation studies are presented showing that the method produces estimators that are nearly asymptotically unbiased and efficient in standard and nonstandard logistic regression models. An oversimiplified but fairly accurate description of the method is that it is method-of-moments estimation using Monte Carlo-derived estimating equations.},
	number = {428},
	urldate = {2026-01-30},
	journal = {Journal of the American Statistical Association},
	publisher = {[American Statistical Association, Taylor \& Francis, Ltd.]},
	author = {Cook, J. R. and Stefanski, L. A.},
	year = {1994},
	pages = {1314--1328},
}

