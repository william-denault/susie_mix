	pages = {269--280},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\RX2X3FDH\\Haviv et al. - 2025 - The covariance environment defines cellular niches for spatial inference.pdf:application/pdf},
