      chromosome <- sub("^chr", "", parts[1])  # Remove 'chr' prefix from 'chrX' to get 'X'
      basepair <- parts[2]  # '100627058'
      return(c(chromosome, basepair))
    } else {
      return(NA)  # If it doesn't match the format
    }
  }
  
