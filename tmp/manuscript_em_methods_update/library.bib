	author = {Gassiat, Élisabeth and Corff, Sylvain Le and Lehéricy, Luc},
	month = feb,
	year = {2022},
	keywords = {Identifiability, 62G07, 62G20, 62H12, 62G05, Adaptivity, Deconvolution, Minimax rates, nonparametric estimation},
	pages = {303--323},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\87PRGVDP\\Gassiat et al. - 2022 - Deconvolution with unknown noise distribution is p.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\XUE8WR3D\\21-AOS2106.html:text/html},
