	doi = {10.1093/hmg/ddab130},
	abstract = {It is important to study the genetics of complex traits in diverse populations. Here, we introduce covariate-adjusted linkage disequilibrium (LD) score regression (cov-LDSC), a method to estimate SNP-heritability (\$\{{\textbackslash}boldsymbol\{h\}\}\_\{{\textbackslash}boldsymbol\{g\}\}{\textasciicircum}\{{\textbackslash}mathbf\{2\}\})\$ and its enrichment in homogenous and admixed populations with summary statistics and in-sample LD estimates. In-sample LD can be estimated from a subset of the genome-wide association studies samples, allowing our method to be applied efficiently to very large cohorts. In simulations, we show that unadjusted LDSC underestimates \$\{{\textbackslash}boldsymbol\{h\}\}\_\{{\textbackslash}boldsymbol\{g\}\}{\textasciicircum}\{{\textbackslash}mathbf\{2\}\}\$ by 10–60\% in admixed populations; in contrast, cov-LDSC is robustly accurate. We apply cov-LDSC to genotyping data from 8124 individuals, mostly of admixed ancestry, from the Slim Initiative in Genomic Medicine for the Americas study, and to approximately 161 000 Latino-ancestry individuals, 47 000 African American-ancestry individuals and 135 000 European-ancestry individuals, as classified by 23andMe. We estimate \$\{{\textbackslash}boldsymbol\{h\}\}\_\{{\textbackslash}boldsymbol\{g\}\}{\textasciicircum}\{{\textbackslash}mathbf\{2\}\}\$ and detect heritability enrichment in three quantitative and five dichotomous phenotypes, making this, to our knowledge, the most comprehensive heritability-based analysis of admixed individuals to date. Most traits have high concordance of \$\{{\textbackslash}boldsymbol\{h\}\}\_\{{\textbackslash}boldsymbol\{g\}\}{\textasciicircum}\{{\textbackslash}mathbf\{2\}\}\$ and consistent tissue-specific heritability enrichment among different populations. However, for age at menarche, we observe population-specific heritability estimates of \$\{{\textbackslash}boldsymbol\{h\}\}\_\{{\textbackslash}boldsymbol\{g\}\}{\textasciicircum}\{{\textbackslash}mathbf\{2\}\}\$. We observe consistent patterns of tissue-specific heritability enrichment across populations; for example, in the limbic system for BMI, the per-standardized-annotation effect size \$ {\textbackslash}tau \$* is 0.16 ± 0.04, 0.28 ± 0.11 and 0.18 ± 0.03 in the Latino-, African American- and European-ancestry populations, respectively. Our approach is a powerful way to analyze genetic data for complex traits from admixed populations.},
	number = {16},
	urldate = {2022-03-09},
	journal = {Human Molecular Genetics},
	author = {Luo, Yang and Li, Xinyi and Wang, Xin and Gazal, Steven and Mercader, Josep Maria and {23 and Me Research Team} and {SIGMA Type 2 Diabetes Consortium} and Neale, Benjamin M and Florez, Jose C and Auton, Adam and Price, Alkes L and Finucane, Hilary K and Raychaudhuri, Soumya},
	month = aug,
	year = {2021},
	pages = {1521--1534},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\T8NF35MG\\Luo et al. - 2021 - Estimating heritability and its enrichment in tiss.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\UXYDB7CT\\6275363.html:text/html},
}

