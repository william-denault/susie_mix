	file = {Version soumise:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\DFPPF9ZE\\Reuter et al. - 2009 - Discrete Laplace–Beltrami operators for shape anal.pdf:application/pdf},
}

@article{valette_wavelet-based_2004,
