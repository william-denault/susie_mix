	month = may,
	year = {2018},
	note = {Number: 5},
	pages = {1287--1292},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\ZSCVF8X8\\Vaucher et al. - 2018 - Cannabis use and risk of schizophrenia a Mendelia.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\VFNLHC4J\\mp2016252.html:text/html},
}

@article{gage_assessing_2017,
	title = {Assessing causality in associations between cannabis use and schizophrenia risk: a two-sample {Mendelian} randomization study},
	volume = {47},
	issn = {0033-2917, 1469-8978},
	shorttitle = {Assessing causality in associations between cannabis use and schizophrenia risk},
	url = {https://www.cambridge.org/core/journals/psychological-medicine/article/assessing-causality-in-associations-between-cannabis-use-and-schizophrenia-risk-a-twosample-mendelian-randomization-study/122D651C3670683DAEDDA33997417105#},
	doi = {10.1017/S0033291716003172},
	abstract = {Background
Observational associations between cannabis and schizophrenia are well documented, but ascertaining causation is more challenging. We used Mendelian randomization (MR), utilizing publicly available data as a method for ascertaining causation from observational data.


Method
We performed bi-directional two-sample MR using summary-level genome-wide data from the International Cannabis Consortium (ICC) and the Psychiatric Genomics Consortium (PGC2). Single nucleotide polymorphisms (SNPs) associated with cannabis initiation (p {\textless} 10−5) and schizophrenia (p {\textless} 5 × 10−8) were combined using an inverse-variance-weighted fixed-effects approach. We also used height and education genome-wide association study data, representing negative and positive control analyses.


Results
There was some evidence consistent with a causal effect of cannabis initiation on risk of schizophrenia [odds ratio (OR) 1.04 per doubling odds of cannabis initiation, 95\% confidence interval (CI) 1.01–1.07, p = 0.019]. There was strong evidence consistent with a causal effect of schizophrenia risk on likelihood of cannabis initiation (OR 1.10 per doubling of the odds of schizophrenia, 95\% CI 1.05–1.14, p = 2.64 × 10−5). Findings were as predicted for the negative control (height: OR 1.00, 95\% CI 0.99–1.01, p = 0.90) but weaker than predicted for the positive control (years in education: OR 0.99, 95\% CI 0.97–1.00, p = 0.066) analyses.


Conclusions
Our results provide some that cannabis initiation increases the risk of schizophrenia, although the size of the causal estimate is small. We find stronger evidence that schizophrenia risk predicts cannabis initiation, possibly as genetic instruments for schizophrenia are stronger than for cannabis initiation.},
	language = {fr},
	number = {5},
	urldate = {2020-06-30},
	journal = {Psychological Medicine},
	publisher = {Cambridge University Press},
	author = {Gage, S. H. and Jones, H. J. and Burgess, S. and Bowden, J. and Smith, G. Davey and Zammit, S. and Munafò, M. R.},
	month = apr,
	year = {2017},
	keywords = {genetics, schizophrenia, Cannabis, Mendelian randomization},
	pages = {971--980},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\E3EGX6B8\\Gage et al. - 2017 - Assessing causality in associations between cannab.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\MIG34ULN\\122D651C3670683DAEDDA33997417105.html:text/html},
}

