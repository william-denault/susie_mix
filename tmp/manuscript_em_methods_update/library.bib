	pages = {R10},
	file = {Full Text:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\7CAE2THY\\Bell et al. - 2011 - DNA methylation patterns associate with genetic an.pdf:application/pdf},
}

