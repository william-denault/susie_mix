	keywords = {Humans, Genotype, Genome-Wide Association Study, Linkage Disequilibrium, Polymorphism, Single Nucleotide, Phenotype, Quantitative Trait Loci, Multiple Sclerosis, Multifactorial Inheritance, Prognosis, Schizophrenia, Models, Theoretical},
