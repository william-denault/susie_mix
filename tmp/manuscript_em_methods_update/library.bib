@article{huan_genome-wide_2019,
	title = {Genome-wide identification of {DNA} methylation {QTLs} in whole blood highlights pathways for cardiovascular disease},
	volume = {10},
	copyright = {2019 This is a U.S. government work and not under copyright protection in the U.S.; foreign copyright protection may apply},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-019-12228-z},
	doi = {10.1038/s41467-019-12228-z},
	abstract = {Identifying methylation quantitative trait loci (meQTLs) and integrating them with disease-associated variants from genome-wide association studies (GWAS) may illuminate functional mechanisms underlying genetic variant-disease associations. Here, we perform GWAS of {\textgreater}415 thousand CpG methylation sites in whole blood from 4170 individuals and map 4.7 million cis- and 630 thousand trans-meQTL variants targeting {\textgreater}120 thousand CpGs. Independent replication is performed in 1347 participants from two studies. By linking cis-meQTL variants with GWAS results for cardiovascular disease (CVD) traits, we identify 92 putatively causal CpGs for CVD traits by Mendelian randomization analysis. Further integrating gene expression data reveals evidence of cis CpG-transcript pairs causally linked to CVD. In addition, we identify 22 trans-meQTL hotspots each targeting more than 30 CpGs and find that trans-meQTL hotspots appear to act in cis on expression of nearby transcriptional regulatory genes. Our findings provide a powerful meQTL resource and shed light on DNA methylation involvement in human diseases.},
	language = {en},
	number = {1},
	urldate = {2020-05-21},
	journal = {Nature Communications},
	publisher = {Nature Publishing Group},
	author = {Huan, Tianxiao and Joehanes, Roby and Song, Ci and Peng, Fen and Guo, Yichen and Mendelson, Michael and Yao, Chen and Liu, Chunyu and Ma, Jiantao and Richard, Melissa and Agha, Golareh and Guan, Weihua and Almli, Lynn M. and Conneely, Karen N. and Keefe, Joshua and Hwang, Shih-Jen and Johnson, Andrew D. and Fornage, Myriam and Liang, Liming and Levy, Daniel},
	month = sep,
	year = {2019},
	note = {Number: 1},
	pages = {4267},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\8MQN64FY\\Huan et al. - 2019 - Genome-wide identification of DNA methylation QTLs.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\EMTUZ98P\\s41467-019-12228-z.html:text/html},
