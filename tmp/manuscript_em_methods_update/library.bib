Subject\_term\_id: epidemiology;genome-wide-association-studies;software},
	pages = {740--747},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\75SQMHSW\\Morrison et al. - 2020 - Mendelian randomization accounting for correlated .pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\ZSXE8YV9\\s41588-020-0631-4.html:text/html},
