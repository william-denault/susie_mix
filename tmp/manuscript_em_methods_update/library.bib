	author = {Athey, Susan and Tibshirani, Julie and Wager, Stefan},
	month = apr,
	year = {2019},
	mrnumber = {MR3909963},
	zmnumber = {07033164},
	keywords = {causal inference, Asymptotic theory, instrumental variable},
	pages = {1148--1178},
	file = {Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\LNPGA6QZ\\1547197251.html:text/html;Version soumise:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\LWGBMEBZ\\Athey et al. - 2019 - Generalized random forests.pdf:application/pdf},
