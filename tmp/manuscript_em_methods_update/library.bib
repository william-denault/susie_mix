	pages = {515--534},
	file = {Texte intégral:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\PHBPYQMB\\Gelman - 2006 - Prior distributions for variance parameters in hie.pdf:application/pdf},
}

