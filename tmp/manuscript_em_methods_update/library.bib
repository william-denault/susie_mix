	keywords = {Follow-Up Studies, Humans, Infant, Newborn, Male, Reference Values, Genetic Predisposition to Disease, Cleft Lip, Prevalence, Databases, Factual, Denmark, Diseases in Twins, Registries, Risk Assessment, Sex Distribution, Twins, Dizygotic, Twins, Monozygotic},
	pages = {313--319},
