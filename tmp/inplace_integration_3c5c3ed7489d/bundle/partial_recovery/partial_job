#!/bin/bash
#SBATCH --job-name=slide_partial_finalize
#SBATCH --partition=broadwl
#SBATCH --time=06:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=48G
set -euo pipefail
bundle=$1
shift
module load R/4.2.0
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
exec python3 "$bundle/partial_resume.py" run "$@"
