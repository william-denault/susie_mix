	pages = {507--514},
	file = {Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\SYPWPN5L\\234985.html:text/html;TOSTESON et TSIATIS - 1988 - The asymptotic relative efficiency of score tests .pdf:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\6I94CMMB\\TOSTESON et TSIATIS - 1988 - The asymptotic relative efficiency of score tests .pdf:application/pdf},
