	pages = {933--947},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\JU9HS3BH\\Swanson et al. - 2018 - Partial Identification of the Average Treatment Ef.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\AFICGVRS\\01621459.2018.html:text/html},
