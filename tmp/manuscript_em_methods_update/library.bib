	keywords = {Functional genomics, Depression},
	pages = {1890--1904},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\GCGL963D\\Chawla et al. - 2025 - Single-nucleus chromatin accessibility profiling identifies cell types and functional variants contr.pdf:application/pdf},
