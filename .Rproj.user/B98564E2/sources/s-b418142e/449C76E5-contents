for (i in seq_len(n_chunks)) {
  
  idx  <- ((i - 1) * chunk_size + 1):min(i * chunk_size, n_genes)
  gset <- genes[idx]
  tag  <- sprintf("%03d", i)
  
  gene_file <- file.path("/project2/mstephens/wdenault/susie_mix/data/temp_index",
                         sprintf("chunk_%s_genes.txt", tag))
  writeLines(gset, gene_file)
  
  script_file <- file.path("/project2/mstephens/wdenault/susie_mix/script/scan_job",
                           sprintf("run_chunk_%s.R", tag))
  
  script_txt <- sprintf('
# Auto-generated by generate_chunks.R -- chunk %s (%d genes)
source("/project2/mstephens/wdenault/susie_mix/script/scan_tissue_attempt/workhorse.R", echo=FALSE)

genes <- readLines("%s")

for (target_gene in genes) {
  cat(sprintf("[%%s] starting %%s\\n", Sys.time(), target_gene))
  out <- tryCatch(
    run_gene_susie(target_gene, shared),
    error = function(e) list(gene = target_gene, error = conditionMessage(e))
  )
  saveRDS(out, file.path("/project2/mstephens/wdenault/susie_mix/results/", paste0(target_gene, ".rds")))
}

cat("Chunk %s done.\\n")
', tag, length(gset), normalizePath(gene_file, mustWork = FALSE), tag)
  
  writeLines(script_txt, script_file)
}