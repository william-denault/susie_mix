@article{dudbridge_predictive_2018,
	title = {Predictive accuracy of combined genetic and environmental risk scores},
	volume = {42},
	issn = {1098-2272},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/gepi.22092},
	doi = {10.1002/gepi.22092},
	abstract = {The substantial heritability of most complex diseases suggests that genetic data could provide useful risk prediction. To date the performance of genetic risk scores has fallen short of the potential implied by heritability, but this can be explained by insufficient sample sizes for estimating highly polygenic models. When risk predictors already exist based on environment or lifestyle, two key questions are to what extent can they be improved by adding genetic information, and what is the ultimate potential of combined genetic and environmental risk scores? Here, we extend previous work on the predictive accuracy of polygenic scores to allow for an environmental score that may be correlated with the polygenic score, for example when the environmental factors mediate the genetic risk. We derive common measures of predictive accuracy and improvement as functions of the training sample size, chip heritabilities of disease and environmental score, and genetic correlation between disease and environmental risk factors. We consider simple addition of the two scores and a weighted sum that accounts for their correlation. Using examples from studies of cardiovascular disease and breast cancer, we show that improvements in discrimination are generally small but reasonable degrees of reclassification could be obtained with current sample sizes. Correlation between genetic and environmental scores has only minor effects on numerical results in realistic scenarios. In the longer term, as the accuracy of polygenic scores improves they will come to dominate the predictive accuracy compared to environmental scores.},
	language = {en},
	number = {1},
	urldate = {2021-08-20},
	journal = {Genetic Epidemiology},
	author = {Dudbridge, Frank and Pashayan, Nora and Yang, Jian},
	year = {2018},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/gepi.22092},
	keywords = {polygenic score, reclassification, risk prediction, risk score, ROC curve},
	pages = {4--19},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\KCWJPQ8D\\Dudbridge et al. - 2018 - Predictive accuracy of combined genetic and enviro.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\5VHYQASD\\gepi.html:text/html},
}

@article{dudbridge_accuracy_2015,
	title = {Accuracy of {Gene} {Scores} when {Pruning} {Markers} by {Linkage} {Disequilibrium}},
	volume = {80},
	issn = {0001-5652, 1423-0062},
	url = {https://www.karger.com/Article/FullText/446581},
	doi = {10.1159/000446581},
	abstract = {\textbf{\textit{Objective:}} Gene scores are often used to model the combined effects of genetic variants. When variants are in linkage disequilibrium, it is common to prune all variants except the most strongly associated. This avoids duplicating information but discards information when variants have independent effects. However, joint modelling of correlated variants increases the sampling error in the gene score. In recent applications, joint modelling has offered only small improvements in accuracy over pruning. We aimed to quantify the relationship between pruning and joint modelling in relation to sample size. \textbf{\textit{Methods:}} We derived the coefficient of determination \textit{R}$^{\textrm{2}}$ for a gene score constructed from pruned markers, and for one constructed from correlated markers with jointly estimated effects. \textbf{\textit{Results:}} Pruned scores tend to have slightly lower \textit{R}$^{\textrm{2}}$ than jointly modelled scores, but the differences are small at sample sizes up to 100,000. If the proportion of correlated variants is high, joint modelling can obtain modest improvements asymptotically. \textbf{\textit{Conclusions:}} The small gains observed to date from joint modelling can be explained by sample size. As studies become larger, joint modelling will be useful for traits affected by many correlated variants, but the improvements may remain small. Pruning remains a useful heuristic for current studies.},
	language = {english},
	number = {4},
	urldate = {2021-08-20},
	journal = {HHE},
	publisher = {Karger Publishers},
	author = {Dudbridge, Frank and Newcombe, Paul J.},
	year = {2015},
	pages = {178--186},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\HZP7D42M\\Dudbridge et Newcombe - 2015 - Accuracy of Gene Scores when Pruning Markers by Li.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\QGT5G74F\\446581.html:text/html},
}

