	pages = {1164--1170},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\ZI9BUMBD\\Lunnon et al. - 2014 - Methylomic profiling implicates cortical deregulat.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\LL6XRL4H\\nn.html:text/html},
