}

@article{nathan_single-cell_2022,
	title = {Single-cell {eQTL} models reveal dynamic {T} cell state dependence of disease loci},
	volume = {606},
	copyright = {2022 The Author(s), under exclusive licence to Springer Nature Limited},
	issn = {1476-4687},
	url = {http://www.nature.com/articles/s41586-022-04713-1},
	doi = {10.1038/s41586-022-04713-1},
	abstract = {Non-coding genetic variants may cause disease by modulating gene expression. However, identifying these expression quantitative trait loci (eQTLs) is complicated by differences in gene regulation across fluid functional cell states within cell types. These states—for example, neurotransmitter-driven programs in astrocytes or perivascular fibroblast differentiation—are obscured in eQTL studies that aggregate cells1,2. Here we modelled eQTLs at single-cell resolution in one complex cell type: memory T cells. Using more than 500,000 unstimulated memory T cells from 259 Peruvian individuals, we show that around one-third of 6,511 cis-eQTLs had effects that were mediated by continuous multimodally defined cell states, such as cytotoxicity and regulatory capacity. In some loci, independent eQTL variants had opposing cell-state relationships. Autoimmune variants were enriched in cell-state-dependent eQTLs, including risk variants for rheumatoid arthritis near ORMDL3 and CTLA4; this indicates that cell-state context is crucial to understanding potential eQTL pathogenicity. Moreover, continuous cell states explained more variation in eQTLs than did conventional discrete categories, such as CD4+ versus CD8+, suggesting that modelling eQTLs and cell states at single-cell resolution can expand insight into gene regulation in functionally heterogeneous cell types.},
	language = {en},
	number = {7912},
	urldate = {2022-11-30},
	journal = {Nature},
	publisher = {Nature Publishing Group},
	author = {Nathan, Aparna and Asgari, Samira and Ishigaki, Kazuyoshi and Valencia, Cristian and Amariuta, Tiffany and Luo, Yang and Beynor, Jessica I. and Baglaenko, Yuriy and Suliman, Sara and Price, Alkes L. and Lecca, Leonid and Murray, Megan B. and Moody, D. Branch and Raychaudhuri, Soumya},
	month = jun,
	year = {2022},
	note = {Number: 7912},
	keywords = {Gene regulation, Quantitative trait loci, Statistical methods, Transcriptomics, T cells},
	pages = {120--128},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\UM4JR4LD\\Nathan et al. - 2022 - Single-cell eQTL models reveal dynamic T cell stat.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\FT3DQXEP\\s41586-022-04713-1.html:text/html},
}

@article{elorbany_single-cell_2022-2,
	title = {Single-cell sequencing reveals lineage-specific dynamic genetic regulation of gene expression during human cardiomyocyte differentiation},
	volume = {18},
	issn = {1553-7404},
	url = {https://journals.plos.org/plosgenetics/article?id=10.1371/journal.pgen.1009666},
	doi = {10.1371/journal.pgen.1009666},
	abstract = {Dynamic and temporally specific gene regulatory changes may underlie unexplained genetic associations with complex disease. During a dynamic process such as cellular differentiation, the overall cell type composition of a tissue (or an in vitro culture) and the gene regulatory profile of each cell can both experience significant changes over time. To identify these dynamic effects in high resolution, we collected single-cell RNA-sequencing data over a differentiation time course from induced pluripotent stem cells to cardiomyocytes, sampled at 7 unique time points in 19 human cell lines. We employed a flexible approach to map dynamic eQTLs whose effects vary significantly over the course of bifurcating differentiation trajectories, including many whose effects are specific to one of these two lineages. Our study design allowed us to distinguish true dynamic eQTLs affecting a specific cell lineage from expression changes driven by potentially non-genetic differences between cell lines such as cell composition. Additionally, we used the cell type profiles learned from single-cell data to deconvolve and re-analyze data from matched bulk RNA-seq samples. Using this approach, we were able to identify a large number of novel dynamic eQTLs in single cell data while also attributing dynamic effects in bulk to a particular lineage. Overall, we found that using single cell data to uncover dynamic eQTLs can provide new insight into the gene regulatory changes that occur among heterogeneous cell types during cardiomyocyte differentiation.},
	language = {en},
	number = {1},
	urldate = {2022-11-30},
	journal = {PLOS Genetics},
	publisher = {Public Library of Science},
	author = {Elorbany, Reem and Popp, Joshua M. and Rhodes, Katherine and Strober, Benjamin J. and Barr, Kenneth and Qi, Guanghao and Gilad, Yoav and Battle, Alexis},
	month = jan,
	year = {2022},
	keywords = {Gene expression, Genetics, Gene regulation, Cardiomyocytes, Cell differentiation, Fibroblasts, Induced pluripotent stem cells, Nonlinear dynamics},
	pages = {e1009666},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\LSV7WGBJ\\Elorbany et al. - 2022 - Single-cell sequencing reveals lineage-specific dy.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\IVX7Q37K\\article.html:text/html},
}

@article{dannemann_harnessing_2022-2,
	title = {Harnessing pluripotent stem cells as models to decipher human evolution},
	volume = {289},
	copyright = {© 2021 Federation of European Biochemical Societies},
	issn = {1742-4658},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/febs.15885},
	doi = {10.1111/febs.15885},
	abstract = {The study of human evolution, long constrained by a lack of experimental model systems, has been transformed by the emergence of the induced pluripotent stem cell (iPSC) field. iPSCs can be readily established from noninvasive tissue sources, from both humans and other primates; they can be maintained in the laboratory indefinitely, and they can be differentiated into other tissue types. These qualities mean that iPSCs are rapidly becoming established as viable and powerful model systems with which it is possible to address questions in human evolution that were until now logistically and ethically intractable, especially in the quest to understand humans' place among the great apes, and the genetic basis of human uniqueness. In this review, we discuss the key lessons and takeaways of this nascent field; from the types of research, iPSCs make possible to lingering challenges and likely future directions. We provide a comprehensive overview of how the seemingly unlikely combination of iPSCs and explicit evolutionary frameworks is transforming what is possible in our understanding of humanity's past and present.},
	language = {en},
	number = {11},
	urldate = {2022-11-30},
	journal = {The FEBS Journal},
	author = {Dannemann, Michael and Gallego Romero, Irene},
	year = {2022},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/febs.15885},
	keywords = {development, gene expression, human evolution, stem cells, tissue models},
	pages = {2992--3010},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\TXFHDUVN\\Dannemann et Gallego Romero - 2022 - Harnessing pluripotent stem cells as models to dec.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\R79SDAZ3\\febs.html:text/html},
}

