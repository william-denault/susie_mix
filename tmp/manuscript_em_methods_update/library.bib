	pages = {367--383},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\REJSLJSG\\Korthauer et al. - 2019 - Detection and accurate false discovery rate contro.pdf:application/pdf},
}

