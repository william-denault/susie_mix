	note = {Number: 1},
	keywords = {Collaborative Filtering},
	pages = {563--568},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\5MHYPY43\\Porteous et al. - 2010 - Bayesian Matrix Factorization with Side Informatio.pdf:application/pdf},
}

@article{varrone_cellcharter_2024,
	title = {{CellCharter} reveals spatial cell niches associated with tissue remodeling and cell plasticity},
	volume = {56},
