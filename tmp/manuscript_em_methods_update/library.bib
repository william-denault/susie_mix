	note = {\_eprint: https://doi.org/10.1080/01621459.2021.1875838},
	keywords = {Empirical Bayes, Compound decision, Shrinkage, James–Stein},
	pages = {1684--1694},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\BEDLQ6Y2\\Zhao et Biscarri - 2022 - A Regression Modeling Approach to Structured Shrin.pdf:application/pdf},
}

