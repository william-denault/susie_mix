	pages = {1854--1862},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\SH9WL76M\\Johnson et Willsky - 2014 - Stochastic Variational Inference for Bayesian Time.pdf:application/pdf},
