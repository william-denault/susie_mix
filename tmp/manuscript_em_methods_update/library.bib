	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\MCTCHL3U\\Avsec et al. - 2021 - Effective gene expression prediction from sequence by integrating long-range interactions.pdf:application/pdf},
