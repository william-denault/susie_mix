	pages = {466--477},
	file = {PubMed Central Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\FA25Q8DF\\Satten et al. - 2001 - Accounting for Unmeasured Population Substructure .pdf:application/pdf},
}

