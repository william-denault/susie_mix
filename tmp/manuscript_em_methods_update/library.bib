	keywords = {Humans, Genome-Wide Association Study, Genetic Predisposition to Disease, Linkage Disequilibrium, Polymorphism, Single Nucleotide, Regression Analysis, Quantitative Trait Loci, Gene Expression, Calibration},
	pages = {626--633},
	file = {Version acceptée:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\TFLD5V26\\Yao et al. - 2020 - Quantifying genetic effects on disease mediated by.pdf:application/pdf},
}

