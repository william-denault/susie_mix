	journal = {Immunol Lett},
	author = {Erdei, Anna and Kovács, Kristóf G. and Nagy-Baló, Zsuzsa and Lukácsi, Szilvia and Mácsik-Valent, Bernadett and Kurucz, István and Bajtay, Zsuzsa},
