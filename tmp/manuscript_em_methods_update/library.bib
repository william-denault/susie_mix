	keywords = {Computer science, Phase transitions and critical phenomena, Statistical physics},
	pages = {9957},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\Y9H6A6ZA\\Biroli et al. - 2024 - Dynamical regimes of diffusion models.pdf:application/pdf},
}

