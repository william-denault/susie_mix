	pages = {615--649},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\TP5HDGTU\\Belomestny et Goldenshluger - 2021 - Density deconvolution under general assumptions on.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\4KGD8UMW\\20-AOS1969.html:text/html},
}

