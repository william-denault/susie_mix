Cg\_type: Nature Research Journals
Number: 1
Primary\_atype: Research
Subject\_term: Computational biology and bioinformatics;Statistical methods
Subject\_term\_id: computational-biology-and-bioinformatics;statistical-methods},
	pages = {3433},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\C8XQS6SN\\Zhang et al. - 2019 - Fast and covariate-adaptive method amplifies detec.pdf:application/pdf},
