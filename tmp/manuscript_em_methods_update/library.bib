	journal = {The Annals of Statistics},
	publisher = {Institute of Mathematical Statistics},
	author = {Haff, L. R.},
	month = may,
	year = {1980},
	keywords = {62F10, Covariance matrix, 62C99, empirical Bayes estimators, unbiased estimation of risk function},
	pages = {586--597},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\F25S2HQZ\\Haff - 1980 - Empirical Bayes Estimation of the Multivariate Nor.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\FAQHR9ED\\1176345010.html:text/html},
