	keywords = {62F12, Singular value decomposition, 62H25, Eigenstructure, HDLSS, noise-reduction methodology, PCA},
	pages = {895--917},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\9TUZ98H7\\Yata et Aoshima - 2016 - Reconstruction of a high-dimensional low-rank matr.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\IXFENULW\\16-EJS1128.html:text/html},
}

