	year = {1998},
	keywords = {Haplotypes, Female, Humans, Male, Animals, Glucose Transporter Type 1, Monosaccharide Transport Proteins, Cell Line, Liver Neoplasms, Blood-Brain Barrier, Brain, Chromosome Mapping, Developmental Disabilities, Microcephaly, Pedigree, Point Mutation, Polymerase Chain Reaction, Rats, Seizures, Skin, Syndrome, Carcinoma, In Situ Hybridization, Genetic, Polymorphism, Hepatocellular, Chromosomes, Fluorescence, Human, Pair 1},
