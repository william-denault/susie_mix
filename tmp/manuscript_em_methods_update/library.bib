Subject\_term\_id: dna-sequencing;genetic-testing;genetic-variation;genome-wide-association-studies;medical-genetics;personalized-medicine},
	pages = {581--590},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\G757PD5L\\Torkamani et al. - 2018 - The personal and clinical utility of polygenic ris.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\N6BJ7H9U\\s41576-018-0018-x.html:text/html},
