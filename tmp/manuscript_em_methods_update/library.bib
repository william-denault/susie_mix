@article{chen_measurement_2005,
	title = {Measurement {Error} {Models} with {Auxiliary} {Data}},
	volume = {72},
	issn = {0034-6527},
	url = {https://www.jstor.org/stable/3700655},
	abstract = {We study the problem of parameter inference in (possibly non-linear and non-smooth) econometric models when the data are measured with error. We allow for arbitrary correlation between the true variables and the measurement errors. To solve the identification problem, we require the existence of an auxiliary data-set that contains information about the conditional distribution of the true variables given the mismeasured variables. Our main assumption requires that the conditional distribution of the true variables given the mismeasured variables is the same in the primary and auxiliary data. Our methods allow the auxiliary data to be a validation sample, where the primary and validation data are from the same distribution, and more importantly, a stratified sample where the auxiliary data-set is not from the same distribution as the primary data. We also show how to combine the two data-sets to obtain a more efficient estimator of the parameter of interest. We establish the large sample properties of the sieve based estimators under verifiable conditions. In particular, we allow for the mismeasured variables to have unbounded supports without employing the tedious trimming scheme typically used in kernel based methods. We illustrate our methods by estimating a returns to schooling censored quantile regression using the CPS/SSR 1978 exact match files where the dependent variable is measured with error of arbitrary kind.},
	number = {2},
	urldate = {2022-01-15},
	journal = {The Review of Economic Studies},
	publisher = {[Oxford University Press, The Review of Economic Studies, Ltd.]},
	author = {Chen, Xiaohong and Hong, Han and Tamer, Elie},
	year = {2005},
	pages = {343--366},
}

@article{belloni_linear_2017,
	title = {Linear and conic programming estimators in high dimensional errors-in-variables models},
	volume = {79},
	issn = {1467-9868},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/rssb.12196},
	doi = {10.1111/rssb.12196},
	abstract = {We consider the linear regression model with observation error in the design. In this setting, we allow the number of covariates to be much larger than the sample size. Several new estimation methods have been recently introduced for this model. Indeed, the standard lasso estimator or Dantzig selector turns out to become unreliable when only noisy regressors are available, which is quite common in practice. In this work, we propose and analyse a new estimator for the errors-in-variables model. Under suitable sparsity assumptions, we show that this estimator attains the minimax efficiency bound. Importantly, this estimator can be written as a second-order cone programming minimization problem which can be solved numerically in polynomial time. Finally, we show that the procedure introduced by Rosenbaum and Tsybakov, which is almost optimal in a minimax sense, can be efficiently computed by a single linear programming problem despite non-convexities.},
	language = {en},
	number = {3},
	urldate = {2022-01-17},
	journal = {Journal of the Royal Statistical Society: Series B (Statistical Methodology)},
	author = {Belloni, Alexandre and Rosenbaum, Mathieu and Tsybakov, Alexandre B.},
