	keywords = {Expression quantitative trait loci (eQTLs), Induced pluripotent stem cells (iPSCs), Single cell RNA-sequencing (scRNA-seq)},
	pages = {76},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\U33H93CG\\Neavin et al. - 2021 - Single cell eQTL analysis identifies cell type-spe.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\R42HXK8C\\s13059-021-02293-3.html:text/html},
