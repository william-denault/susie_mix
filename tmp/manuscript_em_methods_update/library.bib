Number: 6
Primary\_atype: Research
Subject\_term: Biostatistics;Gene expression;Genome-wide association studies
Subject\_term\_id: biostatistics;gene-expression;genome-wide-association-studies},
	keywords = {toread},
	pages = {353--364},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\YDM5Y3HQ\\de Leeuw et al. - 2016 - The statistical properties of gene-set analysis.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\MU67K7FV\\nrg.2016.html:text/html},
