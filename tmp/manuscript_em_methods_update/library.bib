	pages = {4448},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\4IFR3M79\\Helgeland et al. - 2019 - Genome-wide association study reveals dynamic role.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\VI3DJNFR\\s41467-019-12308-0.html:text/html},
