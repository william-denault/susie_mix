	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\V84PI2ZG\\Denault et al. - 2025 - Covariate-moderated Empirical Bayes Matrix Factorization.pdf:application/pdf},
}

