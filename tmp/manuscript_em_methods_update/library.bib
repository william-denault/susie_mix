	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\5XRFTT2C\\Raj-Kumar et al. - 2019 - PCA-PAM50 improves consistency between breast canc.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\NI6B6VHD\\s41598-019-44339-4.html:text/html},
