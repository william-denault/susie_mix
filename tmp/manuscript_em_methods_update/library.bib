	author = {{1000 Genomes Project Consortium} and Auton, Adam and Brooks, Lisa D. and Durbin, Richard M. and Garrison, Erik P. and Kang, Hyun Min and Korbel, Jan O. and Marchini, Jonathan L. and McCarthy, Shane and McVean, Gil A. and Abecasis, Gonçalo R.},
