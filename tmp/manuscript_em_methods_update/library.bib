	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\IPIPRRMH\\Wang et al. - 2026 - Adaptive Selection for False Discovery Rate Control Leveraging Symmetry.pdf:application/pdf},
}

