	volume = {16},
	issn = {0090-5364, 2168-8966},
	url = {https://projecteuclid.org/journals/annals-of-statistics/volume-16/issue-3/Convergence-Rates-for-Empirical-Bayes-Estimation-in-the-Uniform-U0/10.1214/aos/1176350966.full},
	doi = {10.1214/aos/1176350966},
	abstract = {Let \${\textbackslash}\{(X\_i, {\textbackslash}theta\_i){\textbackslash}\}\$ be a sequence of independent random vectors where \$X\_i\$ has a uniform density \$U(0, {\textbackslash}theta\_i)\$ for \$0 {\textless} {\textbackslash}theta\_i {\textless} m ({\textless} {\textbackslash}infty)\$ and the unobservable \${\textbackslash}theta\_i\$ are i.i.d. \$G\$ in some class \${\textbackslash}mathscr\{G\}\$ of prior distributions. In the \$(n + 1)\$st problem we estimate \${\textbackslash}theta\_\{n + 1\}\$ by \$t\_n(X\_1, {\textbackslash}cdots, X\_n, X\_\{n + 1\}) {\textbackslash}doteq t\_n({\textbackslash}mathbf\{X\})\$, incurring the risk \$R\_n {\textbackslash}doteq {\textbackslash}mathbf\{E\}(t\_n({\textbackslash}mathbf\{X\}) - {\textbackslash}theta\_\{n + 1\}){\textasciicircum}2\$, where \${\textbackslash}mathbf\{E\}\$ denotes expectation with respect to all random variables \${\textbackslash}\{(X\_i, {\textbackslash}theta\_i){\textbackslash}\}{\textasciicircum}\{n + 1\}\_\{i = 1\}\$. Let \$R\$ be the infimum Bayes risk with respect to \$G\$. In this paper the author exhibits empirical Bayes estimators with a convergence rate \$O(n{\textasciicircum}\{-1/2\})\$ of \$R\_n - R\$ and shows that there is a sequence of empirical Bayes estimators for which \$R\_n - R\$ has a lower bound of the same order \$n{\textasciicircum}\{-1/2\}\$.},
	number = {3},
	urldate = {2021-04-14},
	journal = {The Annals of Statistics},
	publisher = {Institute of Mathematical Statistics},
	author = {Nogami, Yoshiko},
	month = sep,
	year = {1988},
	keywords = {62C12, 62C25, 62F10, Convergence rates, empirical Bayes estimation, nonexponential family, squared error loss},
	pages = {1335--1341},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\YQ2BCB8G\\Nogami - 1988 - Convergence Rates for Empirical Bayes Estimation i.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\WWCFFB4R\\1176350966.html:text/html},
}

