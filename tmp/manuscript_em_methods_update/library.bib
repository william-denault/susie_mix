	file = {ScienceDirect Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\SSSL4GPA\\Field et al. - 2014 - Strengthening the Reporting of Molecular Epidemiol.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\JZ9ZY7Z5\\S1473309913703244.html:text/html},
