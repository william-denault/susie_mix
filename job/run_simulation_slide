#!/bin/bash
#SBATCH --job-name=susie_slide_sim
#SBATCH --output=susie_slide_sim_%A_%a.out
#SBATCH --error=susie_slide_sim_%A_%a.err
#SBATCH --time=23:00:00
#SBATCH --partition=broadwl
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=4
#SBATCH --mem-per-cpu=5000
#SBATCH --array=0-49

set -euo pipefail
# Default: 50 submitted tasks. Override --array to fit your available QoS quota.
# The offset selects manifest rows; wait for each batch before submitting more.
offset="${1:-0}"
task_id="${SLURM_ARRAY_TASK_ID:?Run this script as a SLURM array.}"
if [[ ! "$offset" =~ ^(0|[1-9][0-9]*)$ ]] ||
   [[ ! "$task_id" =~ ^(0|[1-9][0-9]*)$ ]] || (( task_id >= 400 )); then
  echo "Expected a nonnegative job offset and array indices between 0 and 399." >&2
  exit 1
fi
job_id=$((offset + task_id + 1))
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
module load R/4.2.0
project_dir="${SUSIE_MIX_PROJECT_DIR:-/project2/mstephens/wdenault/susie_mix}"
Rscript "$project_dir/script/sim/run_job.R" "$job_id" "$project_dir"
