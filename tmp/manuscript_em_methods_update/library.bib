	keywords = {hierarchical model, Identifiability, Sparsity, 62F15, 62H25, ancillarity-sufficiency interweaving strategy, fractional priors, Heywood problem, marginal data augmentation, point-mass mixture priors, prior distribution, reversible jump MCMC, rotational invariance},
