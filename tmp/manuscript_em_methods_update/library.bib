	file = {Hellton et Thoresen - 2014 - The Impact of Measurement Error on Principal Compo.pdf:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\NRAP7UNY\\Hellton et Thoresen - 2014 - The Impact of Measurement Error on Principal Compo.pdf:application/pdf},
}

