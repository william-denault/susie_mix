	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\B4VZWQUA\\Kim et al. - 2024 - A flexible empirical Bayes approach to multiple linear regression and connections with penalized reg.pdf:application/pdf;Source Code:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\WZJUDW99\\mr.ash.html:text/html},
}

