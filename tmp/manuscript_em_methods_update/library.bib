	keywords = {Alleles, Female, Humans, Infant, Newborn, Male, European Continental Ancestry Group, Genotype, Genome-Wide Association Study, Genetic Predisposition to Disease, Cleft Lip, Cleft Palate, Polymorphism, Single Nucleotide, genetic epidemiology, Case-Control Studies, cleft lip, cleft palate, Genetic Loci, genetics, meta-analysis, molecular genetics},
