	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/rssb.12196},
	keywords = {Conic programming, Dantzig selector, Linear regression model, Matrix uncertainty selector, Prediction sensitivity},
	pages = {939--956},
	file = {1408.0241(1).pdf:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\R7HX47HH\\1408.0241(1).pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\SNKT442U\\rssb.html:text/html;Version soumise:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\BRR54CJ9\\Belloni et al. - 2017 - Linear and conic programming estimators in high di.pdf:application/pdf},
}

@article{cevid_spectral_2020-1,
