	author = {Bulik-Sullivan, Brendan K. and Loh, Po-Ru and Finucane, Hilary K. and Ripke, Stephan and Yang, Jian and {Schizophrenia Working Group of the Psychiatric Genomics Consortium} and Patterson, Nick and Daly, Mark J. and Price, Alkes L. and Neale, Benjamin M.},
