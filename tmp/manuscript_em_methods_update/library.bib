	year = {1991},
	keywords = {Probability distribution, Signal processing, Genetics, boundedness, Computer science, divergence measures, entropy, Entropy, finiteness, information theory, nonnegativity, Pattern analysis, Pattern recognition, probability of misclassification error, semiboundedness, Shannon entropy, Signal analysis, Taxonomy, Upper bound, variational distance},
	pages = {145--151},
