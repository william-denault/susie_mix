	year = {2020},
	note = {\_eprint: https://rss.onlinelibrary.wiley.com/doi/pdf/10.1111/rssb.12386},
	keywords = {Functional data analysis, Variable selection, Emotional stimuli, Non-parametric regression, On-line video rating, Quasi-maximum-likelihood},
	pages = {1115--1140},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\VXVT8YA7\\Poß et al. - 2020 - Superconsistent estimation of points of impact in .pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\4QJLWGZT\\rssb.html:text/html},
