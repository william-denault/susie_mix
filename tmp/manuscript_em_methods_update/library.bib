	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1467-9868.2005.00532.x},
	keywords = {Lasso, Analysis of variance, Least angle regression, Non-negative garrotte, Piecewise linear solution path},
	pages = {49--67},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\HEB9A8UB\\Yuan and Lin - 2006 - Model selection and estimation in regression with grouped variables.pdf:application/pdf;Snapshot:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\ILSNB6L7\\j.1467-9868.2005.00532.html:text/html},
