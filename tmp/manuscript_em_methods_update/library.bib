	pages = {943--949},
	file = {Full Text PDF:C\:\\Document\\Serieux\\Travail\\ZoteroStorage\\storage\\4EDKSH5U\\Benjamin et al. - 2024 - Multiscale topology classifies cells in subcellular spatial transcriptomics.pdf:application/pdf},
